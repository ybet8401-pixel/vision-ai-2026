rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Central Reusable Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Schemas / Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['name', 'email', 'tier', 'credits', 'maxCredits', 'joinedDate', 'streakDays']) &&
             data.keys().size() <= 9 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.tier in ['Free Trial', 'Quantum Pro', 'Enterprise Cosmic'] &&
             data.credits is int && data.credits >= 0 &&
             data.maxCredits is int && data.maxCredits >= 0 &&
             data.joinedDate is string &&
             data.streakDays is int && data.streakDays >= 0;
    }

    function isValidGeneration(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'prompt', 'output', 'date']) &&
             data.id is string && data.id.size() <= 128 &&
             data.type in ['chat', 'image', 'video', 'voice', 'music', 'code', 'website'] &&
             data.title is string && data.title.size() <= 256 &&
             data.prompt is string && data.prompt.size() <= 10000 &&
             data.output is string && data.output.size() <= 500000 &&
             data.date is string;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'time', 'read']) &&
             data.id is string && data.id.size() <= 128 &&
             data.type in ['info', 'success', 'warning', 'quantum'] &&
             data.title is string && data.title.size() <= 256 &&
             data.message is string && data.message.size() <= 2048 &&
             data.time is string &&
             data.read is bool;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'content', 'timestamp']) &&
             data.id is string && data.id.size() <= 128 &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 50000 &&
             data.timestamp is string;
    }

    // Match Rules per Path Mapping
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      
      // Allow creation of first profile, enforcing default credentials
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      
      // Prohibit users from upgrading tier or arbitrary credits injection
      allow update: if isOwner(userId) && 
                    isValidUserProfile(request.resource.data) && 
                    (request.resource.data.tier == resource.data.tier || request.resource.data.credits < resource.data.credits) && 
                    request.resource.data.joinedDate == resource.data.joinedDate;
      
      // Subcollection Generations
      match /generations/{generationId} {
        allow get: if isOwner(userId) && isValidId(generationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(generationId) && isValidGeneration(request.resource.data);
        allow update: if isOwner(userId) && isValidId(generationId) && isValidGeneration(request.resource.data) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) && isValidId(generationId);
      }

      // Subcollection Notifications
      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(notificationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notificationId) && isValidNotification(request.resource.data);
        allow update: if isOwner(userId) && isValidId(notificationId) && isValidNotification(request.resource.data) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) && isValidId(notificationId);
      }

      // Subcollection Messages (Synapses)
      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidMessage(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }

  }
}
